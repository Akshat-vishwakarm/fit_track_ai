rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile & User Data Collections
    match /users/{userId} {
      // Allow read & write only if request comes from authenticated user matching userId
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All user sub-collections (habits, workouts, meals, goals, progress, ai)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
